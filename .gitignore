# Environment and build
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
node_modules/
frontend/dist/

# Local config: holds absolute paths from your machine
config.json

# Local tool state: agent settings, and the launch config that names ports and
# commands for this machine. `.agent/` is the same thing for a second agent —
# generated skills and workflows, rewritten by `openspec update`, one copy per
# tool. The plan under `openspec/` is tracked on purpose; the instructions that
# teach one editor to read it are not.
.claude/
.agent/

# Canvas state for the nodeterm session tool: machine paths, one per checkout.
.nodeterm/

# Sessions, database, generated images
data/*
!data/catalogue-seed.json
!data/crop-seed.json
!data/candid-cameras-seed.json
!data/selfie-cameras-seed.json
!data/candid-selfie-acts-seed.json
!data/upright-act-seed.json
!data/head-act-seed.json
!data/feet-act-seed.json
!data/camera-candidates-seed.json
!data/solo-acts-seed.json
!data/readings-seed.json
!data/candid-acts-seed.json
!data/directed-cameras-seed.json
!data/candid-rooms-seed.json
!data/directed-looks-seed.json
!data/directed-acts-seed.json
!data/directed-act-readings-seed.json
!data/wardrobe-seed.json

# Written for pasting into an outside assistant, not part of the app
writer-prompts.md
session-200-prompts.md
rewrite-counterargument.md
!data/krea2-depth-control-workflow.json
!data/krea2-prompt-weight-workflow.json
!data/krea2-negpip-workflow.json
!data/krea2-rebalance-workflow.json
!data/krea2-enhancer-workflow.json
!data/krea2-attention-workflow.json
!data/krea2-kgreference-workflow.json
!data/krea2-kgwardrobe-workflow.json

# The translation map is derived from the source libraries' own prose, which the
# operator's licence decision keeps out of this public repo. It normally lives
# beside the source material and never under this tree at all - the pattern is
# here so that a map written under the repo by mistake is still not committable,
# and `save_translation_map` refuses any destination this file does not cover.
translation_map*.json
translation-map*.json
*-translation-map*.json
